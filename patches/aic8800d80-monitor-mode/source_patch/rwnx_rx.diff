+            *pos = DIV_ROUND_UP(band->bitrates[rate_idx].bitrate, 5);
+        else
+            *pos = 2; /* fallback 1 Mbps */
     }
     pos++;
 
@@ -2071,7 +2075,8 @@ u8 rwnx_rxdataind_aicwf(struct rwnx_hw *rwnx_hw, void *hostid, void *rx_priv)
