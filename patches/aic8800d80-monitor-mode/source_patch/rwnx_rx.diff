+    if (hw_rxhdr->is_monitor_vif ||
+        (rwnx_hw->monitor_vif != RWNX_INVALID_VIF && hw_rxhdr->flags_vif_idx == rwnx_hw->monitor_vif)) {
         status = RX_STAT_MONITOR;
         //printk("monitor rx\n");
     }
@@ -2149,6 +2154,11 @@ u8 rwnx_rxdataind_aicwf(struct rwnx_hw *rwnx_hw, void *hostid, void *rx_priv)
         #endif
         }
 
+        if (!skb_monitor) {
+            dev_kfree_skb(skb);
+            goto end;
+        }
+
         skb_reset_tail_pointer(skb);
         skb->len = 0;
         skb_reset_tail_pointer(skb_monitor);
