+#define PRE_TBTT_USEC 8000
+
+static void mt7601u_resync_beacon_timer(struct mt7601u_dev *dev)
+{
+	u32 timer_val = dev->beacon_int << 4;
+
+	dev->tbtt_count++;
+
+	/*
+	 * Beacon timer drifts by 1us every tick, the timer is configured
+	 * in 1/16 TU (64us) units.
+	 */
+	if (dev->tbtt_count < 63)
+		return;
+
+	if (dev->tbtt_count == 63)
+		timer_val -= 1;
+
+	mt76_rmw_field(dev, MT_BEACON_TIME_CFG,
+		       MT_BEACON_TIME_CFG_INTVAL, timer_val);
+
+	if (dev->tbtt_count >= 64)
+		dev->tbtt_count = 0;
+}
+
+static void mt7601u_start_pre_tbtt_timer(struct mt7601u_dev *dev)
+{
+	u64 time;
+	u32 tbtt;
+
+	/* Get remaining TBTT in usec */
+	tbtt = mt76_get_field(dev, MT_TBTT_TIMER, MT_TBTT_TIMER_VAL);
+	tbtt *= 32;
+
+	if (tbtt <= PRE_TBTT_USEC) {
+		queue_work(system_highpri_wq, &dev->pre_tbtt_work);
+		return;
+	}
+
+	time = (tbtt - PRE_TBTT_USEC) * 1000ull;
+	hrtimer_start(&dev->pre_tbtt_timer, ns_to_ktime(time), HRTIMER_MODE_REL);
+}
+
+static void mt7601u_restart_pre_tbtt_timer(struct mt7601u_dev *dev)
+{
+	u32 tbtt, dw0, dw1;
+	u64 tsf, time;
+
+	/* Get remaining TBTT in usec */
+	tbtt = mt76_get_field(dev, MT_TBTT_TIMER, MT_TBTT_TIMER_VAL);
+	tbtt *= 32;
+
+	dw0 = mt7601u_rr(dev, MT_TSF_TIMER_DW0);
+	dw1 = mt7601u_rr(dev, MT_TSF_TIMER_DW1);
+	tsf = (u64)dw0 << 32 | dw1;
+	dev_dbg(dev->dev, "TSF: %llu us TBTT %u us\n", tsf, tbtt);
+
+	/* Convert beacon interval in TU (1024 usec) to nsec */
+	time = ((1000000000ull * dev->beacon_int) >> 10);
+
+	/* Adjust time to trigger hrtimer 8ms before TBTT */
+	if (tbtt < PRE_TBTT_USEC)
+		time -= (PRE_TBTT_USEC - tbtt) * 1000ull;
+	else
+		time += (tbtt - PRE_TBTT_USEC) * 1000ull;
+
+	hrtimer_start(&dev->pre_tbtt_timer, ns_to_ktime(time), HRTIMER_MODE_REL);
+}
+
+static void mt7601u_stop_pre_tbtt_timer(struct mt7601u_dev *dev)
+{
+	do {
+		hrtimer_cancel(&dev->pre_tbtt_timer);
+		cancel_work_sync(&dev->pre_tbtt_work);
+	} while (hrtimer_active(&dev->pre_tbtt_timer));
+}
+
+static int mt7601u_write_beacon(struct mt7601u_dev *dev, int offset,
+				struct ieee80211_vif *vif, struct sk_buff *skb)
+{
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+	struct ieee80211_tx_rate *rate = &info->control.rates[0];
+	struct mt76_txwi txwi;
+	int beacon_len = 512;
+	u16 rateval;
+	u8 nss;
+	u8 *buf;
+	int total_len;
+
+	if (WARN_ON_ONCE(beacon_len < skb->len + sizeof(txwi)))
+		return -ENOSPC;
+
+	if (rate->idx < 0 || !rate->count)
+		ieee80211_get_tx_rates(vif, NULL, skb, info->control.rates, 1);
+
+	if (rate->idx >= 0 && rate->count)
+		rateval = mt76_mac_tx_rate_val(dev, rate, &nss);
+	else
+		rateval = FIELD_PREP(MT_RXWI_RATE_PHY, MT_PHY_TYPE_CCK);
+
+	memset(&txwi, 0, sizeof(txwi));
+	txwi.flags = cpu_to_le16(MT_TXWI_FLAGS_TS);
+	txwi.rate_ctl = cpu_to_le16(rateval);
+	txwi.wcid = 0xff;
+	txwi.len_ctl = cpu_to_le16(skb->len);
+
+	total_len = sizeof(txwi) + skb->len;
+	buf = kzalloc(round_up(total_len, 4), GFP_ATOMIC);
+	if (!buf)
+		return -ENOMEM;
+
+	memcpy(buf, &txwi, sizeof(txwi));
+	memcpy(buf + sizeof(txwi), skb->data, skb->len);
+
+	mt7601u_wr_copy(dev, offset, buf, round_up(total_len, 4));
+	kfree(buf);
+
+	return 0;
+}
+
+static void mt7601u_update_beacon_iter(void *priv, u8 *mac,
+				       struct ieee80211_vif *vif)
+{
+	struct mt7601u_dev *dev = (struct mt7601u_dev *)priv;
+	struct mt76_vif *mvif = (struct mt76_vif *)vif->drv_priv;
+	struct sk_buff *skb = NULL;
+
+	if (!(dev->beacon_mask & BIT(mvif->idx)))
+		return;
+
+	skb = ieee80211_beacon_get(dev->hw, vif);
+	if (!skb)
+		return;
+
+	mt7601u_write_beacon(dev, MT_BEACON_BASE, vif, skb);
+	dev_kfree_skb(skb);
+}
+
+void mt7601u_pre_tbtt_work(struct work_struct *work)
+{
+	struct mt7601u_dev *dev =
+		container_of(work, struct mt7601u_dev, pre_tbtt_work);
+
+	if (!dev->beacon_mask)
+		return;
+
+	if (dev->hw->conf.flags & IEEE80211_CONF_OFFCHANNEL)
+		return;
+
+	mt7601u_resync_beacon_timer(dev);
+
+	/* Prevent corrupt transmissions during update */
+	mt76_set(dev, MT_BCN_BYPASS_MASK, 0xffff);
+
+	ieee80211_iterate_active_interfaces(dev->hw,
+		IEEE80211_IFACE_ITER_RESUME_ALL,
+		mt7601u_update_beacon_iter, dev);
+
+	mt76_wr(dev, MT_BCN_BYPASS_MASK, 0xfffe);
+
+	mt7601u_restart_pre_tbtt_timer(dev);
+}
+
+enum hrtimer_restart mt7601u_pre_tbtt_interrupt(struct hrtimer *timer)
+{
+	struct mt7601u_dev *dev =
+		container_of(timer, struct mt7601u_dev, pre_tbtt_timer);
+
+	queue_work(system_highpri_wq, &dev->pre_tbtt_work);
+
+	return HRTIMER_NORESTART;
+}
+
+void mt7601u_mac_set_beacon_enable(struct mt7601u_dev *dev,
+				   struct ieee80211_vif *vif, bool enable)
+{
+	struct mt76_vif *mvif = (struct mt76_vif *)vif->drv_priv;
+	u8 old_mask = dev->beacon_mask;
+
+	if (enable) {
+		if (WARN_ON_ONCE(!dev->beacon_int))
+			return;
+		dev->beacon_mask |= BIT(mvif->idx);
+	} else {
+		dev->beacon_mask &= ~BIT(mvif->idx);
+	}
+
+	if (!!old_mask == !!dev->beacon_mask)
+		return;
+
+	if (dev->beacon_mask) {
+		dev->tbtt_count = 0;
+		mt76_set(dev, MT_BEACON_TIME_CFG,
+			 MT_BEACON_TIME_CFG_BEACON_TX |
+			 MT_BEACON_TIME_CFG_TBTT_EN |
+			 MT_BEACON_TIME_CFG_TIMER_EN |
+			 MT_BEACON_TIME_CFG_SYNC_MODE);
+		mt76_rmw_field(dev, MT_MAC_BSSID_DW1,
+			       MT_MAC_BSSID_DW1_MBSS_MODE, 3);
+		mt76_set(dev, MT_MAC_BSSID_DW1,
+			 MT_MAC_BSSID_DW1_MBSS_LOCAL_BIT);
+		mt76_rmw_field(dev, MT_MAC_BSSID_DW1,
+			       MT_MAC_BSSID_DW1_MBEACON_N, 7);
+		if (!hrtimer_active(&dev->pre_tbtt_timer))
+			mt7601u_start_pre_tbtt_timer(dev);
+	} else {
+		mt76_clear(dev, MT_BEACON_TIME_CFG,
+			   MT_BEACON_TIME_CFG_BEACON_TX |
+			   MT_BEACON_TIME_CFG_TBTT_EN |
+			   MT_BEACON_TIME_CFG_TIMER_EN);
+		mt7601u_stop_pre_tbtt_timer(dev);
+	}
+}
