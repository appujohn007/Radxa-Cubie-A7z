From 5236ccb417628bf1b9e00748499dc051d9ccd3b3 Mon Sep 17 00:00:00 2001
From: Appu John <161853537+appujohn007@users.noreply.github.com>
Date: Sat, 22 Aug 2026 15:13:40 +0000
Subject: [PATCH 2/2] aic8800: make monitor TX queue NULL-safe and enable
 injection

---
 .../aic8800/usb/aic8800_fdrv/Makefile         |  2 +-
 .../aic8800/usb/aic8800_fdrv/rwnx_tx.c        | 42 ++++++++-----------
 .../aic8800/usb/aic8800_fdrv/rwnx_tx.h        |  2 +-
 3 files changed, 20 insertions(+), 26 deletions(-)

diff --git a/drivers/net/wireless/aic8800/usb/aic8800_fdrv/Makefile b/drivers/net/wireless/aic8800/usb/aic8800_fdrv/Makefile
index d0970cbd..d1068215 100644
--- a/drivers/net/wireless/aic8800/usb/aic8800_fdrv/Makefile
+++ b/drivers/net/wireless/aic8800/usb/aic8800_fdrv/Makefile
@@ -144,7 +144,7 @@ CONFIG_RWNX_BCMC ?= y
 
 # Enable Monitor+Data interface support (need FW support)
 CONFIG_RWNX_MON_DATA =n
-CONFIG_RWNX_MON_XMIT ?= n
+CONFIG_RWNX_MON_XMIT ?= y
 CONFIG_RWNX_MON_RXFILTER ?= n
 
 CONFIG_FILTER_TCP_ACK =y
diff --git a/drivers/net/wireless/aic8800/usb/aic8800_fdrv/rwnx_tx.c b/drivers/net/wireless/aic8800/usb/aic8800_fdrv/rwnx_tx.c
index d7b9a403..ff8daa6b 100644
--- a/drivers/net/wireless/aic8800/usb/aic8800_fdrv/rwnx_tx.c
+++ b/drivers/net/wireless/aic8800/usb/aic8800_fdrv/rwnx_tx.c
@@ -319,6 +319,11 @@ u16 rwnx_select_txq(struct rwnx_vif *rwnx_vif, struct sk_buff *skb)
             sta = rwnx_vif->sta.ap;
         break;
     }
+    case NL80211_IFTYPE_MONITOR:
+        skb->priority = TID_MGT;
+        txq = rwnx_txq_vif_get(rwnx_vif, NX_UNK_TXQ_TYPE);
+        netdev_queue = txq->ndev_idx;
+        return netdev_queue;
     case NL80211_IFTYPE_AP_VLAN:
         if (rwnx_vif->ap_vlan.sta_4a) {
             sta = rwnx_vif->ap_vlan.sta_4a;
@@ -1856,7 +1861,7 @@ int rwnx_start_mgmt_xmit(struct rwnx_vif *vif, struct rwnx_sta *sta,
 
 netdev_tx_t rwnx_start_monitor_if_xmit(struct sk_buff *skb, struct net_device *dev)
 {
-    int rtap_len, ret, idx, tmp_len;
+    int rtap_len, ret, idx;
     struct ieee80211_radiotap_header *rtap_hdr; // net/ieee80211_radiotap.h
     struct ieee80211_radiotap_iterator iterator; // net/cfg80211.h
     u8_l *rtap_buf = (u8_l *)skb->data;
@@ -1870,12 +1875,10 @@ netdev_tx_t rwnx_start_monitor_if_xmit(struct sk_buff *skb, struct net_device *d
     struct rwnx_sta *sta;
     struct rwnx_txq *txq;
     u16_l frame_len, headroom, frame_oft;
-    u8_l tid, rate_fmt = FORMATMOD_NON_HT, rate_idx = 0, txsig_bw = PHY_CHNL_BW_20;
+    u8_l rate_fmt = FORMATMOD_NON_HT, rate_idx = 0, txsig_bw = PHY_CHNL_BW_20;
     u8_l *pframe, *data;
     bool robust;
     struct sk_buff *skb_mgmt;
-    bool offchan = false;
-    int nx_off_chan_txq_idx = NX_OFF_CHAN_TXQ_IDX;
 
     rtap_hdr = (struct ieee80211_radiotap_header*)(rtap_buf);
     rtap_len = ieee80211_get_radiotap_len(rtap_buf);//max_length
@@ -1883,12 +1886,6 @@ netdev_tx_t rwnx_start_monitor_if_xmit(struct sk_buff *skb, struct net_device *d
 
     AICWFDBG(LOGINFO, "rwnx_start_monitor_if_xmit, skb_len=%d, rtap_len=%d\n", skb->len, rtap_len);
 //rwnx_data_dump((char*)__func__, skb->data, skb->len);
-    if((g_rwnx_plat->usbdev->chipid == PRODUCT_ID_AIC8801) ||
-        ((g_rwnx_plat->usbdev->chipid == PRODUCT_ID_AIC8800DC ||
-        g_rwnx_plat->usbdev->chipid == PRODUCT_ID_AIC8800DW) && chip_id < 3)){
-            nx_off_chan_txq_idx = NX_OFF_CHAN_TXQ_IDX_FOR_OLD_IC;
-    }
-
 
     if (unlikely(rtap_hdr->it_version)){
         AICWFDBG(LOGERROR, "%s itv \r\n", __func__);
@@ -1915,6 +1912,12 @@ netdev_tx_t rwnx_start_monitor_if_xmit(struct sk_buff *skb, struct net_device *d
         if (ret) {
             continue;
         }
+        if (unlikely(!iterator.this_arg)) {
+            AICWFDBG(LOGERROR, "%s null radiotap field for index %d\r\n",
+                    __func__, iterator.this_arg_index);
+            ret = -EINVAL;
+            goto free_tag;
+        }
         AICWFDBG(LOGDEBUG, "%s iterator.this_arg_index:%d iterator.this_arg:%x\r\n", __func__, 
             iterator.this_arg_index, *iterator.this_arg);
         switch (iterator.this_arg_index) {
@@ -2087,20 +2090,11 @@ netdev_tx_t rwnx_start_monitor_if_xmit(struct sk_buff *skb, struct net_device *d
     }
     #endif
 
-    /* Get the STA id and TID information */
-    sta = rwnx_get_tx_priv(vif, skb, &tid);
-    //if (!sta) {
-    //    printk("sta=null, tid=0x%x\n", tid);
-    //}
-    /* Set TID and Queues indexes */
-    if (sta) {
-        txq = rwnx_txq_sta_get(sta, 8, rwnx_hw);
-    } else {
-        if (offchan)
-            txq = &rwnx_hw->txq[nx_off_chan_txq_idx];
-        else
-            txq = rwnx_txq_vif_get(vif, NX_UNK_TXQ_TYPE);
-    }
+    /* Monitor injection is not associated with a peer STA; use the VIF
+     * unknown TXQ to avoid dereferencing uninitialized STA state.
+     */
+    sta = NULL;
+    txq = rwnx_txq_vif_get(vif, NX_UNK_TXQ_TYPE);
     if (txq->idx == TXQ_INACTIVE) {
         AICWFDBG(LOGERROR, "TXQ_INACTIVE\n");
         goto free_tag;
diff --git a/drivers/net/wireless/aic8800/usb/aic8800_fdrv/rwnx_tx.h b/drivers/net/wireless/aic8800/usb/aic8800_fdrv/rwnx_tx.h
index da4511d6..4c92ffbc 100644
--- a/drivers/net/wireless/aic8800/usb/aic8800_fdrv/rwnx_tx.h
+++ b/drivers/net/wireless/aic8800/usb/aic8800_fdrv/rwnx_tx.h
@@ -171,7 +171,7 @@ int rwnx_start_mgmt_xmit(struct rwnx_vif *vif, struct rwnx_sta *sta,
                          u64 *cookie);
 #endif /* LINUX_VERSION_CODE >= KERNEL_VERSION(3, 14, 0) */
 #ifdef CONFIG_RWNX_MON_XMIT
-int rwnx_start_monitor_if_xmit(struct sk_buff *skb, struct net_device *dev);
+netdev_tx_t rwnx_start_monitor_if_xmit(struct sk_buff *skb, struct net_device *dev);
 #endif
 int rwnx_txdatacfm(void *pthis, void *host_id);
 
-- 
2.53.0

